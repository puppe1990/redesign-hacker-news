{
  "manifest_version": 3,
  "name": "Hacker News Editorial Redesign",
  "version": "1.0.0",
  "description": "Redesenha o Hacker News no Chrome com uma interface editorial mais limpa e legível.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://news.ycombinator.com/*"
      ],
      "css": [
        "src/styles/tokens.css",
        "src/styles/shell.css",
        "src/styles/type-modal.css",
        "src/styles/listing.css",
        "src/styles/discussion.css",
        "src/styles/chrome-controls.css",
        "src/styles/forms.css",
        "src/styles/pages.css",
        "src/styles/responsive.css"
      ],
      "js": [
        "src/constants.js",
        "src/theme.js",
        "src/type-settings.js",
        "src/dom.js",
        "src/topbar.js",
        "src/listings.js",
        "src/discussion.js",
        "src/pages/favorites.js",
        "src/pages/forgot.js",
        "src/pages/showlim.js",
        "src/pages/user.js",
        "src/pages/submit.js",
        "src/boot.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
